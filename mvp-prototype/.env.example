# Kora Pilot — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# ─────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta)
# Get these from: https://developers.facebook.com/apps
# ─────────────────────────────────────────────────────────

# Your WhatsApp Business Phone Number ID
# Found in: App Dashboard → WhatsApp → API Setup → "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Permanent System User Access Token (NOT the temporary test token)
# Create at: Business Settings → System Users → Generate Token
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# The WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# ─────────────────────────────────────────────────────────
# Webhook Verification
# ─────────────────────────────────────────────────────────

# Any secret string YOU choose — must match exactly what you set in
# Meta App Dashboard → WhatsApp → Configuration → Webhook → Verify Token
WEBHOOK_VERIFY_TOKEN=kora_amber_shelter_2026

# ─────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────

PORT=3000

# Your public ngrok URL (without trailing slash).
# Update this each time ngrok restarts.
# Example: https://a1b2c3d4.ngrok-free.app
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# ─────────────────────────────────────────────────────────
# Pilot Agency Configuration
# ─────────────────────────────────────────────────────────

AGENCY_NAME=Amber Shelter

# First message Kora sends to every new enquiry (24/7 acknowledgement)
GREETING_MESSAGE=Hello! Welcome to Amber Shelter 🏡 I'm Kora, your 24/7 digital assistant. A qualified consultant will follow up with you shortly.\n\nTo match you with the right property, may I have your *full name* please?
